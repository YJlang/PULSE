LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=pulse_db
# 홍보영상 프롬프트 기획/추천은 DEEPSEEK_API_KEY(없으면 OPENAI_API_KEY), 업로드 사진 분석은 OPENAI_API_KEY를 쓴다.
PROMOTION_PROMPT_PROVIDER=deepseek
PROMOTION_PROMPT_MODEL=deepseek-flash
PROMOTION_VISION_MODEL=gpt-5-mini
# 아래 Google 키들은 PROMOTION_VIDEO_PROVIDER=veo로 되돌릴 때만 필요하다.
GEMINI_API_KEY=replace-with-your-gemini-api-key
VEO_API_KEY=replace-with-your-veo-api-key
GOOGLE_CLOUD_PROJECT=replace-with-your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_VIDEO_API_KEY=replace-with-your-vertex-video-api-key
PROMOTION_VEO_PROVIDER=vertex
PROMOTION_VEO_ENABLE_SECONDARY_BACKEND_FALLBACK=false
PROMOTION_VEO_ASPECT_RATIO=9:16
# Keep false for vertical reels. Current Veo backends can reject 9:16 output
# when an uploaded image is sent as a reference image; PULSE still uses uploads
# for prompt/image analysis before text-to-video generation.
PROMOTION_VEO_ALLOW_VERTICAL_REFERENCE_IMAGES=false
PROMOTION_VEO_VERTEX_STANDARD_MODEL=veo-2.0-generate-001
PROMOTION_VEO_VERTEX_PRO_MODEL=veo-2.0-generate-001
PROMOTION_VEO_VERTEX_FAST_MODEL=veo-2.0-generate-001
PROMOTION_VEO_VERTEX_STANDARD_RESOLUTION=720p
# Vertex AI video generation in this project expects ADC/service-account auth.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Runway API 영상 생성 (Seedance 등) — https://dev.runway.com 에서 발급한 API 키
# RUNWAYML_API_SECRET이 있으면 기본 영상 백엔드가 runway가 된다. Veo로 되돌리려면 PROMOTION_VIDEO_PROVIDER=veo
RUNWAYML_API_SECRET=replace-with-your-runway-api-key
PROMOTION_VIDEO_PROVIDER=runway
PROMOTION_RUNWAY_MODEL=seedance2_5
# "가로:세로" 픽셀. 1080:1920 = 1080p 세로(초당 68크레딧), 720:1280 = 720p 세로(초당 30크레딧)
PROMOTION_RUNWAY_RATIO=1080:1920
PROMOTION_RUNWAY_FAST_RATIO=720:1280
PROMOTION_RUNWAY_DURATION=8
PROMOTION_RUNWAY_AUDIO=true
# reference: 업로드 사진을 참고 이미지로 사용, first_frame: 영상 첫 프레임으로 고정
PROMOTION_RUNWAY_IMAGE_MODE=reference
# 네이버 DataLab 검색어 트렌드 (대시보드 '오늘의 기회 신호') — developers.naver.com 앱의 Client ID/Secret
NAVER_CLIENT_ID=replace-with-your-naver-client-id
NAVER_CLIENT_SECRET=replace-with-your-naver-client-secret
